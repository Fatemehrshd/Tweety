# Copy to backend/.env and adjust per app.
# Shared defaults shown here.

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=final_project

# Redis
REDIS_URL=redis://localhost:6379

# JWT secrets — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-please-replace
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-please-replace

# Server
NODE_ENV=development
LOG_LEVEL=info

# Frontend (NEXT_PUBLIC_API_BASE_URL)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
